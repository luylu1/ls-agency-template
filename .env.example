# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_read_token          # Sanity → API → Tokens → Add API token (Editor)
SANITY_WEBHOOK_SECRET=your_webhook_secret # random string, same in Sanity webhook config

# E-Mail via Resend (resend.com — kostenloses Tier: 3.000 E-Mails/Monat)
RESEND_API_KEY=re_your_key
CONTACT_EMAIL_TO=kontakt@kunde.de         # wohin Leads gesendet werden
CONTACT_EMAIL_FROM=noreply@kundenwebsite.de

# Site
NEXT_PUBLIC_SITE_URL=https://www.kundenwebsite.de
